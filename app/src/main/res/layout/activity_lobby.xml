<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:gravity="center"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FORSAKEN"
        android:textColor="#F5C7D8"
        android:textSize="48sp"
        android:textStyle="bold|italic"
        android:fontFamily="serif"
        android:shadowColor="#D32F2F"
        android:shadowRadius="20"
        android:layout_marginBottom="20dp"/>

    <!-- Đã ẩn tvIp để tránh lỗi khởi tạo -->
    <TextView
        android:id="@+id/tvIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP: Đang tải..."
        android:textColor="#00E5FF"
        android:visibility="gone" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Nhập tên của bạn..."
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnSinglePlayer"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="▶ CHƠI OFFLINE"
        android:backgroundTint="#7CFFB2"
        android:textColor="#000000"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnCreateRoom"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="TẠO PHÒNG"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etIp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="Nhập IP Host..."
        android:textColor="#FFFFFF"
        android:backgroundTint="#00E5FF"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnJoin"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="VÀO PHÒNG"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000"/>

</LinearLayout>
